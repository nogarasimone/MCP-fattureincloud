# Configurazione di fic-mcp. Copia in ~/.config/fic-mcp/.env oppure .env nella cartella
# da cui lanci il server. Le variabili già presenti nell'ambiente hanno la precedenza.

# --- Accesso a Fatture in Cloud -------------------------------------------------
# Opzione A: token manuale (Impostazioni → Applicazioni collegate → Sviluppatori)
FIC_ACCESS_TOKEN=

# Opzione B: OAuth2 (necessari per `fic-mcp auth` e il rinnovo automatico del token)
FIC_CLIENT_ID=
FIC_CLIENT_SECRET=
# FIC_REFRESH_TOKEN=
# FIC_TOKEN_FILE=~/.config/fic-mcp/tokens.json

# Obbligatoria solo se il token gestisce più aziende
# FIC_COMPANY_ID=

# --- Comportamento --------------------------------------------------------------
# true nasconde tutti i tool che scrivono
FIC_READ_ONLY=true
# off | tokenize (sostituisce i dati personali con segnaposto)
FIC_PRIVACY_MODE=off
# default | all | elenco separato da virgole (es. account,entities,issued,analytics)
# FIC_TOOLSETS=default
# % dell'imponibile incassato da accantonare, oltre all'IVA
# FIC_SET_ASIDE_PCT=48
# Registro delle scritture; "off" per disattivarlo
# FIC_AUDIT_LOG=~/.local/state/fic-mcp/audit.jsonl

# --- Modalità HTTP ----------------------------------------------------------------
# Bearer obbligatorio con `fic-mcp serve --transport http` (es. openssl rand -hex 32)
# FIC_MCP_HTTP_TOKEN=
# Dietro reverse proxy: nomi pubblici ammessi nell'header Host, separati da virgola
# FIC_MCP_ALLOWED_HOSTS=mcp.tuodominio.it

# --- Avanzate -------------------------------------------------------------------
# FIC_BASE_URL=https://api-v2.fattureincloud.it
# FIC_TIMEOUT=30
# FIC_MAX_RETRIES=4
